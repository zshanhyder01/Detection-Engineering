title: Unusual Network Logon via Machine Account
id: detect_Network_Logon_via_Machine_Account_t1078.002
status: experimental
description: Detects a machine account ($) performing a network logon (Type 3). This is a key step in Coerced Authentication.
author: Zeeshan Haider
logsource:
    product: windows
    service: security
detection:
    selection:
        EventID: 4624  # Successful Logon
        LogonType: 3   # Network Logon
        TargetUserName|endswith: '$'
    filter:
        IpAddress:
            - '::1'
            - '127.0.0.1'
    condition: selection and not filter
fields:
    - EventID
    - TargetUserName
    - IpAddress
    - LogonType
falsepositives:
    - Normal inter-server communication (SCCM, Cluster services, Backups).
tags:
    - attack.privilege_escalation
    - attack.t1078.002 # Domain Accounts
level: medium
