/* Title: Sacrificial Process for Ticket Injection
   ID: detect_sacrificial_process_ticket_injection_T1550.003
   Author: Zeeshan Haider
   Description: Detects a process created in a different logon session than its parent/subject.
*/

process where event.code == "4688" and 
  winlog.event_data.SubjectLogonId != winlog.event_data.TargetLogonId and
  not winlog.event_data.TargetLogonId == "0x3e7" /* Exclude System/Service sessions */
